# ===== GestãoClick =====
# Gere em sua conta GestãoClick (Access Token + Secret Access Token).
GC_ACCESS_TOKEN=coloque_o_access_token_aqui
GC_SECRET_TOKEN=coloque_o_secret_access_token_aqui
# Opcional: se você tem mais de uma loja. Veja IDs em GET /api/lojas/
GC_LOJA_ID=

# ===== ClickUp =====
# Personal API token do ClickUp (Settings > Apps). Começa com "pk_".
CLICKUP_TOKEN=pk_coloque_o_token_aqui

# IDs das listas de OS (do Space 8. Repair Center)
CLICKUP_LIST_AVULSO=901714621075
CLICKUP_LIST_CPFL=901714621079
CLICKUP_LIST_NEOENERGIA=901714621083

# ===== Roteamento Avulso x Contrato =====
# Mapeia o centro_custo_id do GestãoClick para uma das listas acima.
# Formato: <centro_custo_id>:<AVULSO|CPFL|NEOENERGIA>, separados por vírgula.
# Ex.: "1:CPFL,2:NEOENERGIA". Tudo que não casar cai em AVULSO.
GC_CENTRO_CUSTO_MAP=

# ===== Comportamento do sync =====
# Cron de execução (padrão: a cada 10 minutos).
SYNC_CRON=*/10 * * * *
# Quantos dias pra trás olhar a cada rodada (janela incremental).
LOOKBACK_DAYS=3
# Status inicial dado ao card recém-criado (precisa existir na lista).
INITIAL_STATUS=Entrada e Pré-Análise
# Roda uma vez e sai (útil pra testar). Também via flag --once.
RUN_ONCE=false
